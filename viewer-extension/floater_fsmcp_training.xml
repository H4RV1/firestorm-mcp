<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="fsmcp_training" title="Range and timing trainer" width="550" height="440" layout="topleft" can_resize="false" save_rect="true" single_instance="true">
  <check_box name="enabled" label="Show local training overlay" control_name="FSMCPTrainingEnabled" left="16" top="34" width="300" height="22"/>
  <text name="prediction_note" left="16" top="62" width="520" height="36" wrap="true">Local prediction only. This panel never attacks or confirms damage. Green = ready/in volume; amber = cooldown; red = outside.</text>
  <spinner name="range" label="Range (m)" control_name="FSMCPTrainingRange" left="16" top="104" width="165" height="22" label_width="95" min_val="0.1" max_val="96" increment="0.1" decimal_digits="1"/>
  <spinner name="angle" label="Half-angle (deg)" control_name="FSMCPTrainingHalfAngle" left="190" top="104" width="180" height="22" label_width="110" min_val="1" max_val="180" increment="1" decimal_digits="0"/>
  <spinner name="cooldown" label="Cooldown (s)" control_name="FSMCPTrainingCooldown" left="16" top="134" width="165" height="22" label_width="95" min_val="0" max_val="60" increment="0.1" decimal_digits="1"/>
  <check_box name="eligible_only" label="Only eligible attempts start cooldown (prediction)" control_name="FSMCPTrainingEligibleOnly" left="16" top="164" width="520" height="22"/>
  <text name="target_label" left="16" top="196" width="126" height="20">Target gesture</text>
  <combo_box name="target_gesture" left="145" top="192" width="310" height="24"/>
  <text name="attack_label" left="16" top="224" width="126" height="20">Attack gesture</text>
  <combo_box name="attack_gesture" left="145" top="220" width="310" height="24"/>
  <button name="refresh" label="Refresh" left="462" top="220" width="75" height="24"/>
  <text name="gesture_note" left="16" top="252" width="520" height="32" wrap="true">Bindings observe gestures you play normally. Choose the gesture assigned to your target key. No gesture is played by this panel.</text>
  <button name="nearest" label="Select nearest locally" left="16" top="292" width="210" height="26"/>
  <button name="attempt" label="Rehearse attack (local only)" left="236" top="292" width="290" height="26"/>
  <text name="geometry" left="16" top="328" width="520" height="34" wrap="true">No target</text>
  <text name="timing" left="16" top="365" width="520" height="22">Local cooldown</text>
  <text name="last_attempt" left="16" top="394" width="520" height="32" wrap="true">No attempt recorded</text>
</floater>
